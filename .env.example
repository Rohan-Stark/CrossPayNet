# ==============================================================================
# CrossPayNet - Environment Configuration Template (.env.example)
#
# Educational Cross-Border Payment Messaging & Settlement Simulator
#
# SECURITY WARNING:
# NEVER commit the actual .env file or real secrets to version control.
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Boot Runtime Configuration
# ------------------------------------------------------------------------------
# Active Spring Profile (use 'local' for local development with defaults)
SPRING_PROFILES_ACTIVE=local

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 18)
# ------------------------------------------------------------------------------
# Host port mapping for Docker Compose PostgreSQL container
POSTGRES_PORT=5432

# PostgreSQL credentials and database name
POSTGRES_DB=crosspaynet
POSTGRES_USER=crosspaynet_user
POSTGRES_PASSWORD=crosspaynet_password

# Spring Boot JDBC Datasource connection properties
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/crosspaynet
SPRING_DATASOURCE_USERNAME=crosspaynet_user
SPRING_DATASOURCE_PASSWORD=crosspaynet_password

# ------------------------------------------------------------------------------
# 3. Apache Kafka Configuration (KRaft Mode, Kafka 3.8.0)
# ------------------------------------------------------------------------------
# Host port mapping for Docker Compose Kafka container
KAFKA_PORT=9092

# Advertised host for external / host clients connecting to Kafka broker
KAFKA_ADVERTISED_HOST=localhost

# Spring Boot Kafka bootstrap servers
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ------------------------------------------------------------------------------
# 4. Application Security & RBAC Users (In-Memory Simulation)
# ------------------------------------------------------------------------------
# Customer Portal User (Role: CUSTOMER)
CROSSPAYNET_CUSTOMER_USERNAME=customer
CROSSPAYNET_CUSTOMER_PASSWORD=customer123!

# Compliance Reviewer User (Role: COMPLIANCE)
CROSSPAYNET_COMPLIANCE_USERNAME=compliance
CROSSPAYNET_COMPLIANCE_PASSWORD=compliance123!

# Operations Analyst User (Role: OPERATIONS)
CROSSPAYNET_OPERATIONS_USERNAME=operations
CROSSPAYNET_OPERATIONS_PASSWORD=operations123!

# System Administrator User (Role: ADMIN)
CROSSPAYNET_ADMIN_USERNAME=admin
CROSSPAYNET_ADMIN_PASSWORD=admin123!

# ------------------------------------------------------------------------------
# 5. Operations Scheduled Reconciliation (ShedLock Distributed Lock)
# ------------------------------------------------------------------------------
# Scheduled periodic reconciliation scans (disabled by default)
CROSSPAYNET_OPERATIONS_RECONCILIATION_SCHEDULING_ENABLED=false
CROSSPAYNET_OPERATIONS_RECONCILIATION_SCHEDULING_CRON=0 */15 * * * *
CROSSPAYNET_OPERATIONS_RECONCILIATION_SCHEDULING_LOCK_AT_MOST_FOR=30m
CROSSPAYNET_OPERATIONS_RECONCILIATION_SCHEDULING_LOCK_AT_LEAST_FOR=5m
